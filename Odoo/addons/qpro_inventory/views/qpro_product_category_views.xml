<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de product.category y añadir campos QPro -->
    <record id="view_product_category_qpro_form" model="ir.ui.view">
        <field name="name">product.category.qpro.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="QPro Inventario" col="2">
                    <field name="qpro_type"/>
                    <field name="qpro_color"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
