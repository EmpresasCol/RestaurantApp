<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qpro_delivery_address_list" model="ir.ui.view">
        <field name="name">qpro.delivery.address.list</field>
        <field name="model">qpro.delivery.address</field>
        <field name="arch" type="xml">
            <tree string="Direcciones">
                <field name="partner_id"/>
                <field name="street"/>
                <field name="neighborhood"/>
                <field name="city"/>
                <field name="state_name"/>
            </tree>
        </field>
    </record>

    <record id="view_qpro_delivery_address_form" model="ir.ui.view">
        <field name="name">qpro.delivery.address.form</field>
        <field name="model">qpro.delivery.address</field>
        <field name="arch" type="xml">
            <form string="Dirección de entrega">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="street"/>
                        <field name="neighborhood"/>
                        <field name="additional_ref"/>
                        <field name="city"/>
                        <field name="state_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qpro_delivery_address" model="ir.actions.act_window">
        <field name="name">Direcciones de entrega</field>
        <field name="res_model">qpro.delivery.address</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
