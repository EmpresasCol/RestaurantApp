<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── KANBAN ────────────────────────────────────────────────────────────── -->
    <record id="view_qpro_delivery_kanban" model="ir.ui.view">
        <field name="name">qpro.delivery.kanban</field>
        <field name="model">qpro.delivery</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="partner_id"/>
                <field name="total"/>
                <field name="delivery_person_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div><field name="partner_id"/></div>
                            <div class="text-muted"><field name="address_id"/></div>
                            <div>
                                <field name="total" widget="monetary"/>
                                <t t-if="record.delivery_person_id.value">
                                    · <field name="delivery_person_id"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── LIST ─────────────────────────────────────────────────────────────── -->
    <record id="view_qpro_delivery_list" model="ir.ui.view">
        <field name="name">qpro.delivery.list</field>
        <field name="model">qpro.delivery</field>
        <field name="arch" type="xml">
            <tree string="Domicilios"
                  decoration-warning="state == 'pending'"
                  decoration-info="state == 'preparing'"
                  decoration-primary="state == 'on_way'"
                  decoration-success="state == 'delivered'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="address_id"/>
                <field name="state"/>
                <field name="delivery_person_id"/>
                <field name="total"/>
                <field name="payment_method"/>
                <field name="order_date"/>
            </tree>
        </field>
    </record>

    <!-- ── FORM ─────────────────────────────────────────────────────────────── -->
    <record id="view_qpro_delivery_form" model="ir.ui.view">
        <field name="name">qpro.delivery.form</field>
        <field name="model">qpro.delivery</field>
        <field name="arch" type="xml">
            <form string="Domicilio">
                <header>
                    <button name="action_start_preparing" type="object"
                            string="Iniciar preparación"
                            invisible="state != 'pending'"
                            class="btn-primary"/>
                    <button name="action_send_on_way" type="object"
                            string="Enviar a domicilio"
                            invisible="state != 'preparing'"
                            class="btn-primary"/>
                    <button name="action_mark_delivered" type="object"
                            string="Marcar entregado"
                            invisible="state != 'on_way'"
                            class="btn-primary"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar"
                            invisible="state in ('delivered', 'cancelled')"
                            class="btn-danger"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,preparing,on_way,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            Token: <field name="tracking_token" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="partner_id"/>
                            <field name="address_id"/>
                            <field name="restaurant_id"/>
                        </group>
                        <group string="Asignación">
                            <field name="creator_id"/>
                            <field name="delivery_person_id"/>
                            <field name="order_date"/>
                            <field name="estimated_delivery_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pago">
                            <field name="payment_method"/>
                            <field name="prepaid"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="delivery_cost"/>
                            <field name="subtotal"/>
                            <field name="total"/>
                        </group>
                        <group string="Observaciones">
                            <field name="customer_notes"/>
                            <field name="internal_notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Fechas" name="dates">
                            <group>
                                <field name="pickup_date" readonly="1"/>
                                <field name="delivery_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_qpro_delivery" model="ir.actions.act_window">
        <field name="name">Domicilios</field>
        <field name="res_model">qpro.delivery</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_state': 'pending'}</field>
    </record>
</odoo>
