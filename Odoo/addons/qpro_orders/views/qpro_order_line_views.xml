<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         VISTA TREE EDITABLE: para usar embebida en el formulario
         del pedido. El usuario añade/quita líneas como en Excel.
         ============================================================ -->
    <record id="view_qpro_order_line_tree" model="ir.ui.view">
        <field name="name">qpro.order.line.tree</field>
        <field name="model">qpro.order.line</field>
        <field name="arch" type="xml">
            <tree string="Líneas del pedido" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="note"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'preparing'"
                       decoration-success="state == 'ready'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         VISTA FORM: solo se abre desde la vista de cocina (futuro)
         para editar el estado individual de una línea sin abrir
         todo el pedido.
         ============================================================ -->
    <record id="view_qpro_order_line_form" model="ir.ui.view">
        <field name="name">qpro.order.line.form</field>
        <field name="model">qpro.order.line</field>
        <field name="arch" type="xml">
            <form string="Línea de pedido">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                        </group>
                        <group>
                            <field name="price_unit" readonly="1"/>
                            <field name="price_subtotal" readonly="1"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Nota para cocina">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>