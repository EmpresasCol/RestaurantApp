<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Secuencia para generar folios de pedidos QPro.
        Formato resultante: PED/2026/00001, PED/2026/00002, ...

        Componentes:
          - prefix: lo que va antes del número.
            %(range_year)s = año del rango actual.
          - padding: 5 ceros a la izquierda.
          - implementation: 'no_gap' garantiza secuencia sin saltos
            (ligeramente más lento pero correcto para auditoría).
          - use_date_range: True permite reiniciar el contador cada año.
    -->
    <record id="seq_qpro_order" model="ir.sequence">
        <field name="name">Folio de pedido QPro</field>
        <field name="code">qpro.order</field>
        <field name="prefix">PED/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>