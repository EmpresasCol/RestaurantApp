# ====================================================
# RESTAURANT APP - VARIABLES DE ENTORNO (DOCKER)
# ====================================================

# Entorno ASP.NET Core (Production o Development)
ENVIRONMENT=Production
ENABLE_SWAGGER=false

# Clave de firma JWT (mínimo 32 caracteres aleatorios). Sin ella las sesiones
# se invalidan cada vez que se reinicia la API.
JWT_KEY=
# Orígenes del frontend autorizados por CORS, separados por coma
CORS_ORIGENES=http://localhost:3000,http://localhost:3001

# Puertos expuestos en el Host (evitan conflictos con puertos locales)
WEB_PORT=3001
API_PORT=5000
DB_PORT=3307

# Configuración de Base de Datos MySQL
DB_NAME=restaurantebd
DB_ROOT_PASSWORD=root
DB_USER=restaurant_user
DB_PASSWORD=restaurant_password

# URL de la API consumida por el Frontend Web
# '/api' utiliza el reverse-proxy de Nginx eliminando problemas de CORS
REACT_APP_API_URL=/api
