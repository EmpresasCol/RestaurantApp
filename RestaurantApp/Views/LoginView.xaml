<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantApp.ViewModels"
             x:Class="RestaurantApp.Views.LoginView"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <vm:LoginViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="30" VerticalOptions="Center">

            <Label Text="🍽️" FontSize="80" HorizontalOptions="Center"/>
            <Label Text="RestaurantApp" FontSize="32" FontAttributes="Bold" TextColor="#FF6B35" HorizontalOptions="Center"/>

            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="25">
                <VerticalStackLayout Spacing="20">

                    <Entry Text="{Binding NombreUsuario}" Placeholder="Usuario" FontSize="16"/>
                    <Entry Text="{Binding Password}" Placeholder="Contraseña" IsPassword="True" FontSize="16"/>

                    <Frame BackgroundColor="#FFEBEE" BorderColor="#F44336" CornerRadius="8" Padding="15" IsVisible="{Binding MostrarError}">
                        <Label Text="{Binding MensajeError}" TextColor="#C62828" FontSize="13"/>
                    </Frame>

                    <Button Text="Iniciar Sesión" Command="{Binding IniciarSesionCommand}" BackgroundColor="#FF6B35" TextColor="White" FontSize="16" HeightRequest="50"/>

                    <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" Color="#FF6B35"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>