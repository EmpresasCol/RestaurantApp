<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantApp.Views.ConfiguracionView"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- ============================================ -->
            <!-- SECCIÓN: INFORMACIÓN PERSONAL -->
            <!-- ============================================ -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2937}" 
                   CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="👤 Información Personal" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nombre del Mesero" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Entry Text="{Binding NombreMesero}"
                               Placeholder="Ingresa tu nombre"
                               BackgroundColor="{AppThemeBinding Light=#f9fafb, Dark=#374151}"
                               TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ============================================ -->
            <!-- SECCIÓN: CONEXIÓN AL SERVIDOR -->
            <!-- ============================================ -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2937}" 
                   CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⚙️ Conexión al Servidor" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>

                    <!-- Tipo de dispositivo -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Dispositivo:" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Label Text="{Binding TipoDispositivo}" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                    </HorizontalStackLayout>

                    <!-- Estado de conexión -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Estado:" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Label Text="{Binding EstadoConexion}" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="{Binding ColorConexion}"/>
                    </HorizontalStackLayout>

                    <!-- URL actual -->
                    <Label Text="{Binding TextoUrlServidor}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"
                           LineBreakMode="CharacterWrap"/>

                    <!-- Campo de entrada de URL -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="URL del Servidor" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Entry Placeholder="{Binding IpSugerida}"
                               Text="{Binding UrlServidor}"
                               Keyboard="Url"
                               ClearButtonVisibility="WhileEditing"
                               BackgroundColor="{AppThemeBinding Light=#f9fafb, Dark=#374151}"
                               TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                    </VerticalStackLayout>

                    <!-- Botones de acción -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button Grid.Column="0"
                                Text="🔄 Resetear"
                                Command="{Binding ResetearUrlCommand}"
                                BackgroundColor="#f59e0b"
                                TextColor="White"
                                FontSize="13"
                                Padding="10"
                                CornerRadius="8"/>

                        <Button Grid.Column="1"
                                Text="✓ Verificar"
                                Command="{Binding VerificarConexionCommand}"
                                BackgroundColor="#10b981"
                                TextColor="White"
                                FontSize="13"
                                Padding="10"
                                CornerRadius="8"/>
                    </Grid>

                    <!-- Ayuda contextual -->
                    <Frame Padding="12" 
                           BackgroundColor="{AppThemeBinding Light=#dbeafe, Dark=#1e3a8a}" 
                           CornerRadius="8"
                           Margin="0,5,0,0">
                        <Label FontSize="12" 
                               TextColor="{AppThemeBinding Light=#1e40af, Dark=#93c5fd}"
                               LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="💡 Ayuda:" FontAttributes="Bold"/>
                                    <Span Text="&#x0a;"/>
                                    <Span Text="• Emulador: usa 10.0.2.2:5176"/>
                                    <Span Text="&#x0a;"/>
                                    <Span Text="• Dispositivo físico: usa la IP de tu PC"/>
                                    <Span Text="&#x0a;"/>
                                    <Span Text="• Ejemplo: http://192.168.1.100:5176"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- ============================================ -->
            <!-- SECCIÓN: PREFERENCIAS -->
            <!-- ============================================ -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2937}" 
                   CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🎨 Preferencias" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>

                    <!-- Modo Oscuro -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Modo Oscuro" 
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                            <Label Text="Cambiar tema de la aplicación" 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ModoOscuro}" 
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" 
                             Color="{AppThemeBinding Light=#e5e7eb, Dark=#374151}"/>

                    <!-- Notificaciones -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Notificaciones" 
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                            <Label Text="Recibir alertas de pedidos" 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NotificacionesActivas}" 
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" 
                             Color="{AppThemeBinding Light=#e5e7eb, Dark=#374151}"/>

                    <!-- Sonidos -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Sonidos" 
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                            <Label Text="Activar efectos de sonido" 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SonidosActivos}" 
                                VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- ============================================ -->
            <!-- SECCIÓN: ESTADÍSTICAS -->
            <!-- ============================================ -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2937}" 
                   CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📊 Estadísticas de Hoy" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" RowSpacing="15">
                        <!-- Pedidos Tomados -->
                        <Frame Grid.Column="0" Padding="12" 
                               BackgroundColor="{AppThemeBinding Light=#dbeafe, Dark=#1e3a8a}" 
                               CornerRadius="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="📝 Pedidos" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#1e40af, Dark=#93c5fd}"/>
                                <Label Text="{Binding PedidosTomados}" 
                                       FontSize="24" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1e40af, Dark=#93c5fd}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Mesas Atendidas -->
                        <Frame Grid.Column="1" Padding="12" 
                               BackgroundColor="{AppThemeBinding Light=#dcfce7, Dark=#14532d}" 
                               CornerRadius="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="🪑 Mesas" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#15803d, Dark=#86efac}"/>
                                <Label Text="{Binding MesasAtendidas}" 
                                       FontSize="24" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#15803d, Dark=#86efac}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <Button Text="🔄 Resetear Estadísticas"
                            Command="{Binding ResetearEstadisticasCommand}"
                            BackgroundColor="#ef4444"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="12"/>
                </VerticalStackLayout>
            </Frame>

            <!-- ============================================ -->
            <!-- SECCIÓN: INFORMACIÓN DEL SISTEMA -->
            <!-- ============================================ -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f2937}" 
                   CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ℹ️ Información del Sistema" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Versión:" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Label Text="{Binding VersionApp}" 
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Dispositivo:" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"/>
                        <Label Text="{Binding InfoDispositivo}" 
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#1f2937, Dark=#f9fafb}"/>
                    </HorizontalStackLayout>

                    <Button Text="🔍 Ver Diagnósticos"
                            Command="{Binding VerDiagnosticosCommand}"
                            BackgroundColor="#6366f1"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="12"/>
                </VerticalStackLayout>
            </Frame>

            <!-- ============================================ -->
            <!-- BOTONES DE ACCIÓN -->
            <!-- ============================================ -->
            <VerticalStackLayout Spacing="12">
                <Button Text="💾 Guardar Configuración"
                        Command="{Binding GuardarConfiguracionCommand}"
                        BackgroundColor="#10b981"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="15"/>

                <Button Text="🚪 Cerrar Sesión"
                        Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="#ef4444"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="10"
                        Padding="15"/>
            </VerticalStackLayout>

            <!-- Espaciado final -->
            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>