<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantApp.Views.MeseroView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Mesero - Toma de Pedidos">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*">

        <!-- Header -->
        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" 
                     BackgroundColor="DarkBlue" Padding="15">
            <Label Text="Vista Mesero" TextColor="White" FontSize="20" FontAttributes="Bold"/>
            <Button Text="Nuevo Pedido" BackgroundColor="Green" TextColor="White"
                    Command="{Binding NuevoPedidoCommand}" Margin="20,0,0,0"/>
        </StackLayout>

        <!-- Left Panel - Nuevo Pedido / Selección -->
        <ScrollView Grid.Row="1" Grid.Column="0">
            <StackLayout Padding="15" Spacing="10">

                <!-- Selección de Mesa -->
                <Frame BackgroundColor="LightGray" Padding="10">
                    <StackLayout>
                        <Label Text="Seleccionar Mesa:" FontSize="16" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Mesas}" 
                                      SelectedItem="{Binding MesaSeleccionada}"
                                      SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="4"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="5">
                                        <Frame BackgroundColor="{Binding EstaOcupada, Converter={StaticResource BoolToColorConverter}}"
                                               Padding="10" CornerRadius="5">
                                            <Label Text="{Binding Numero, StringFormat='Mesa {0}'}" 
                                                   HorizontalOptions="Center" TextColor="White"/>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Categorías de Productos -->
                <Frame BackgroundColor="LightGray" Padding="10">
                    <StackLayout>
                        <Label Text="Categorías:" FontSize="16" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Categorias}"
                                      SelectedItem="{Binding CategoriaSeleccionada}"
                                      SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding}" BackgroundColor="Orange" TextColor="White"
                                            Margin="5" Padding="15,10"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Productos Disponibles -->
                <Frame BackgroundColor="LightGray" Padding="10">
                    <StackLayout>
                        <Label Text="Productos:" FontSize="16" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding ProductosFiltrados}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="5">
                                        <Frame BackgroundColor="White" Padding="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackLayout Grid.Column="0">
                                                    <Label Text="{Binding Nombre}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Descripcion}" FontSize="12" TextColor="Gray"/>
                                                    <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                                           TextColor="Green" FontAttributes="Bold"/>
                                                </StackLayout>
                                                <Stepper Grid.Column="1" Value="{Binding CantidadTemporal}" 
                                                        Minimum="0" Maximum="20" Increment="1"/>
                                                <Button Grid.Column="2" Text="Agregar" BackgroundColor="Blue" 
                                                       TextColor="White" Command="{Binding BindingContext.AgregarProductoCommand, 
                                                       Source={x:Reference Name=MeseroPage}}"
                                                       CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Pedido Actual -->
                <Frame BackgroundColor="LightBlue" Padding="10">
                    <StackLayout>
                        <Label Text="Pedido Actual:" FontSize="16" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding ItemsPedidoActual}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <Label Grid.Column="0" Text="{Binding Producto.Nombre}"/>
                                        <Label Grid.Column="1" Text="{Binding Cantidad, StringFormat='x{0}'}"/>
                                        <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='${0:F2}'}"/>
                                        <Button Grid.Column="3" Text="X" BackgroundColor="Red" TextColor="White"
                                               Command="{Binding BindingContext.RemoverItemCommand, 
                                               Source={x:Reference Name=MeseroPage}}"
                                               CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding TotalPedidoActual, StringFormat='Total: ${0:F2}'}" 
                               FontAttributes="Bold" FontSize="18" TextColor="Green" HorizontalOptions="End"/>

                        <Entry Placeholder="Notas especiales..." Text="{Binding NotasEspeciales}"/>

                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" Text="Cancelar Pedido" BackgroundColor="Red" 
                                   TextColor="White" Command="{Binding CancelarPedidoCommand}"/>
                            <Button Grid.Column="1" Text="Confirmar Pedido" BackgroundColor="Green" 
                                   TextColor="White" Command="{Binding ConfirmarPedidoCommand}"/>
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Right Panel - Pedidos Existentes -->
        <ScrollView Grid.Row="1" Grid.Column="1">
            <StackLayout Padding="15" Spacing="10">

                <Frame BackgroundColor="LightYellow" Padding="10">
                    <StackLayout>
                        <Label Text="Pedidos Pendientes de Pago:" FontSize="16" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding PedidosPendientes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="White" Padding="10" Margin="0,5">
                                        <StackLayout>
                                            <Grid ColumnDefinitions="*,*">
                                                <Label Grid.Column="0" Text="{Binding Mesa.Numero, StringFormat='Mesa: {0}'}" 
                                                       FontAttributes="Bold"/>
                                                <Label Grid.Column="1" Text="{Binding FechaHora, StringFormat='{0:HH:mm}'}" 
                                                       HorizontalOptions="End"/>
                                            </Grid>

                                            <CollectionView ItemsSource="{Binding Items}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                            <Label Grid.Column="0" Text="{Binding Producto.Nombre}"/>
                                                            <Label Grid.Column="1" Text="{Binding Cantidad, StringFormat='x{0}'}"/>
                                                            <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='${0:F2}'}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>

                                            <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="0,5"/>

                                            <Label Text="{Binding Total, StringFormat='Total: ${0:F2}'}" 
                                                   FontAttributes="Bold" HorizontalOptions="End"/>

                                            <Entry Placeholder="Agregar item adicional..." 
                                                   Text="{Binding ItemAdicionalTemporal}"/>

                                            <Grid ColumnDefinitions="*,*">
                                                <Button Grid.Column="0" Text="Agregar Item" 
                                                       BackgroundColor="Orange" TextColor="White"
                                                       Command="{Binding BindingContext.AgregarItemAdicionalCommand,
                                                       Source={x:Reference Name=MeseroPage}}"
                                                       CommandParameter="{Binding}"/>
                                                <Button Grid.Column="1" Text="Cancelar Pedido" 
                                                       BackgroundColor="Red" TextColor="White"
                                                       Command="{Binding BindingContext.CancelarPedidoExistenteCommand,
                                                       Source={x:Reference Name=MeseroPage}}"
                                                       CommandParameter="{Binding}"/>
                                            </Grid>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

    </Grid>

</ContentPage>