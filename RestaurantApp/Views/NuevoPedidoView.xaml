<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantApp.Views.NuevoPedidoView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:RestaurantApp.Converters"
             Title="Nuevo Pedido"
             BackgroundColor="#F8F9FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:IntToBoolInverseConverter x:Key="IntToBoolInverseConverter"/>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header mejorado -->
        <StackLayout Grid.Row="0" BackgroundColor="#FF6B35" Padding="20,15">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackLayout Grid.Column="0">
                    <Label Text="Nuevo Pedido" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold"/>
                    <Label Text="{Binding MesaSeleccionada, StringFormat='Mesa: {0}', FallbackValue='Seleccione una mesa'}" 
                           TextColor="White" 
                           FontSize="16"
                           Opacity="0.9"/>
                </StackLayout>

                <Frame BackgroundColor="#FF6B35" 
       CornerRadius="0" 
       Padding="20" 
       HasShadow="True"
       Margin="0,0,0,20">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                        <!-- Título -->
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="Nuevo Pedido" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="White"/>

                        <!-- Mesa Seleccionada -->
                        <Label Grid.Row="1" Grid.Column="0"
               FontSize="14" 
               TextColor="White"
               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Mesa: " />
                                    <Span Text="{Binding MesaSeleccionada.Numero, FallbackValue='Sin seleccionar'}" 
                          FontAttributes="Bold"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Resumen del pedido -->
                        <Frame Grid.Row="1" Grid.Column="1"
               BackgroundColor="White"
               Padding="10"
               CornerRadius="8"
               Margin="10,0">
                            <Label TextColor="#FF6B35" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CantidadItemsPedido}" FontSize="16"/>
                                        <Span Text=" items" FontSize="12"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Frame>

                        <Frame Grid.Row="1" Grid.Column="2"
               BackgroundColor="White"
               Padding="10"
               CornerRadius="8">
                            <Label Text="{Binding TotalPedido, StringFormat='${0:N0}'}"
                   TextColor="#FF6B35"
                   FontSize="16"
                   FontAttributes="Bold"/>
                        </Frame>
                    </Grid>
                </Frame>
            </Grid>
        </StackLayout>

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="15" Spacing="20">

                <!-- Selección de Mesa - Mejorada -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Label Text="🪑 Seleccionar Mesa" 
               FontSize="18" 
               FontAttributes="Bold" 
               TextColor="#333"
               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding MesasDisponibles}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" 
                                Span="6" 
                                VerticalItemSpacing="8" 
                                HorizontalItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{Binding ColorEstado}"
                           Padding="0"
                           CornerRadius="10"
                           HasShadow="True"
                           HeightRequest="60"
                           WidthRequest="60"
                           BorderColor="{Binding BorderColor}"
                           Opacity="{Binding OpacidadMesa}"
                           IsEnabled="{Binding EstaHabilitadaParaSeleccion}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
                                Command="{Binding BindingContext.SeleccionarMesaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding}"/>
                                        </Frame.GestureRecognizers>
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="12">
                                            <Label Text="{Binding Numero}" 
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding CapacidadTexto}" 
                                   TextColor="White"
                                   FontSize="10"
                                   HorizontalOptions="Center"
                                   Opacity="0.8"/>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Indicador de mesa seleccionada -->
                        <Frame BackgroundColor="#E3F2FD" 
               CornerRadius="8" 
               Padding="15" 
               Margin="0,15,0,0"
               IsVisible="{Binding MesaSeleccionada, Converter={StaticResource IsNotNullConverter}}">
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="✓ Mesa seleccionada: " 
                              TextColor="#1976D2"
                              FontSize="14"/>
                                        <Span Text="{Binding MesaSeleccionada.Numero}" 
                              TextColor="#1976D2"
                              FontSize="14"
                              FontAttributes="Bold"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Frame>

                        <!-- Leyenda de estados -->
                        <StackLayout Orientation="Horizontal" 
                     Spacing="15" 
                     HorizontalOptions="Center"
                     Margin="0,15,0,0">
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Green" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Disponible" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Orange" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Ocupada" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Red" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Por pagar" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Categorías - Mejoradas -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Label Text="🍽️ Categorías del Menú" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"
                               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding Categorias}"
                                      SelectedItem="{Binding CategoriaSeleccionada}"
                                      SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding NombreConIcono}"
                                            BackgroundColor="{Binding ColorFondo}"
                                            TextColor="White"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            Padding="20,12"
                                            MinimumWidthRequest="100"
                                            Command="{Binding BindingContext.SeleccionarCategoriaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Productos del Menú - Completamente rediseñados -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="📋 Productos Disponibles" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#333"/>
                            <Label Grid.Column="1"
                                   Text="{Binding PlatillosFiltrados.Count, StringFormat='{0} productos'}"
                                   FontSize="12"
                                   TextColor="#666"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Barra de búsqueda -->
                        <SearchBar Placeholder="Buscar productos..."
                                   Text="{Binding BusquedaTexto}"
                                   BackgroundColor="#F8F9FA"
                                   Margin="0,15,0,10"/>

                        <CollectionView ItemsSource="{Binding PlatillosFiltrados}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#FAFAFA" 
                                           CornerRadius="12" 
                                           Padding="15" 
                                           Margin="0,8"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="80,*,120">

                                            <!-- Imagen del producto -->
                                            <Frame Grid.Column="0" 
                                                   CornerRadius="12" 
                                                   Padding="0"
                                                   HeightRequest="70"
                                                   WidthRequest="70"
                                                   BackgroundColor="#E9ECEF">
                                                <Label Text="🍽️"
                                                       FontSize="30"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Frame>

                                            <!-- Información del producto -->
                                            <StackLayout Grid.Column="1" 
                                                       Padding="15,0"
                                                       VerticalOptions="Center">
                                                <Label Text="{Binding Nombre}" 
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="#333"/>
                                                <Label Text="{Binding Descripcion}" 
                                                       FontSize="12"
                                                       TextColor="#666"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"/>
                                                <Label Text="{Binding PrecioFormateado}" 
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="#FF6B35"
                                                       Margin="0,5,0,0"/>
                                            </StackLayout>

                                            <!-- Controles de cantidad -->
                                            <StackLayout Grid.Column="2" 
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="End">

                                                <!-- Mostrar cantidad si es mayor a 0 -->
                                                <StackLayout Orientation="Horizontal" 
                                                           HorizontalOptions="Center"
                                                           IsVisible="{Binding CantidadTemporal, Converter={StaticResource IntToBoolConverter}}"
                                                           Spacing="8">
                                                    <Button Text="−"
                                                            BackgroundColor="#DC3545"
                                                            TextColor="White"
                                                            FontSize="18"
                                                            FontAttributes="Bold"
                                                            CornerRadius="20"
                                                            WidthRequest="40"
                                                            HeightRequest="40"
                                                            Command="{Binding BindingContext.DisminuirCantidadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Frame BackgroundColor="#FF6B35"
                                                           Padding="12,8"
                                                           CornerRadius="15">
                                                        <Label Text="{Binding CantidadTemporal}"
                                                               FontAttributes="Bold"
                                                               FontSize="16"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"/>
                                                    </Frame>

                                                    <Button Text="+"
                                                            BackgroundColor="#28A745"
                                                            TextColor="White"
                                                            FontSize="18"
                                                            FontAttributes="Bold"
                                                            CornerRadius="20"
                                                            WidthRequest="40"
                                                            HeightRequest="40"
                                                            Command="{Binding BindingContext.AumentarCantidadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackLayout>

                                                <!-- Botón agregar si cantidad es 0 -->
                                                <Button Text="+ Agregar"
                                                        BackgroundColor="#28A745"
                                                        TextColor="White"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        CornerRadius="20"
                                                        Padding="16,10"
                                                        IsVisible="{Binding CantidadTemporal, Converter={StaticResource IntToBoolInverseConverter}}"
                                                        Command="{Binding BindingContext.AgregarProductoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Resumen del Pedido -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="20" 
                       HasShadow="True"
                       IsVisible="{Binding TienePedidoActual}">
                    <StackLayout>
                        <Label Text="🛒 Resumen del Pedido" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"
                               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding ItemsPedidoActual}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" 
                                          Padding="0,8" 
                                          BackgroundColor="Transparent">
                                        <StackLayout Grid.Column="0">
                                            <Label Text="{Binding Platillo.Nombre}" 
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="#333"/>
                                            <Label Text="{Binding Platillo.PrecioFormateado}" 
                                                   FontSize="12"
                                                   TextColor="#666"/>
                                        </StackLayout>

                                        <Label Grid.Column="1" 
                                               Text="{Binding Cantidad, StringFormat='x{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#FF6B35"
                                               VerticalOptions="Center"
                                               Margin="0,0,15,0"/>

                                        <Button Grid.Column="2"
                                                Text="🗑️"
                                                BackgroundColor="Transparent"
                                                TextColor="#DC3545"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Command="{Binding BindingContext.EliminarItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,15"/>

                        <!-- Notas especiales -->
                        <Entry Placeholder="Notas especiales para el pedido..."
                               Text="{Binding NotasEspeciales}"
                               BackgroundColor="#F8F9FA"
                               Margin="0,0,0,15"/>

                        <!-- Total -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" 
                                   Text="TOTAL:" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalPedido, StringFormat='${0:N0}'}" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="#FF6B35"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Footer con botones de acción -->
        <StackLayout Grid.Row="2" 
                     BackgroundColor="White" 
                     Padding="20,15"
                     Spacing="10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Grid.Column="0"
                        Text="🗑️ Limpiar"
                        BackgroundColor="#6C757D"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding LimpiarPedidoCommand}"/>

                <Button Grid.Column="1"
                        Text="✅ Confirmar Pedido"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding ConfirmarPedidoCommand}"
                        IsEnabled="{Binding PuedeConfirmarPedido}"/>
            </Grid>

            <!-- Botón volver al inicio -->
            <Button Text="🏠 Volver al Inicio"
                    BackgroundColor="Transparent"
                    TextColor="#666"
                    FontSize="14"
                    Command="{Binding VolverInicioCommand}"/>
        </StackLayout>

    </Grid>

</ContentPage>