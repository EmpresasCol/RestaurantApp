<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantApp.Views.NuevoPedidoView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:RestaurantApp.Converters"
             Title="Nuevo Pedido"
             BackgroundColor="#F8F9FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:IntToBoolInverseConverter x:Key="IntToBoolInverseConverter"/>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Frame Grid.Row="0" 
       BackgroundColor="#FF6B35" 
       CornerRadius="0" 
       Padding="20,15" 
       HasShadow="True">
            <Grid RowDefinitions="Auto,Auto" 
          ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- BOTÓN VOLVER AL INICIO -->
                <Button Grid.Row="0" 
                Grid.Column="0"
                Text="🏠"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="24"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                Margin="0,0,10,0"
                Command="{Binding VolverInicioCommand}"/>

                <!-- Título -->
                <Label Grid.Row="0" 
               Grid.Column="1" 
               Grid.ColumnSpan="3"
               Text="Nuevo Pedido" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="White"
               Margin="0,0,0,10"/>

                <!-- Mesa Seleccionada -->
                <Label Grid.Row="1" 
               Grid.Column="1"
               FontSize="14" 
               TextColor="White"
               VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Mesa: " />
                            <Span Text="{Binding MesaSeleccionada.Numero, FallbackValue='Sin seleccionar'}" 
                          FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Resumen: Cantidad de items -->
                <Frame Grid.Row="1" 
               Grid.Column="2"
               BackgroundColor="White"
               Padding="10,8"
               CornerRadius="8"
               Margin="10,0"
               HasShadow="False">
                    <Label TextColor="#FF6B35" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding CantidadItemsPedido}" FontSize="16"/>
                                <Span Text=" items" FontSize="12"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>

                <!-- Resumen: Total -->
                <Frame Grid.Row="1" 
               Grid.Column="3"
               BackgroundColor="White"
               Padding="10,8"
               CornerRadius="8"
               HasShadow="False">
                    <Label Text="{Binding TotalPedido, StringFormat='${0:N0}'}"
                   TextColor="#FF6B35"
                   FontSize="16"
                   FontAttributes="Bold"/>
                </Frame>
            </Grid>
        </Frame>

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="15" Spacing="20">

                <!-- Selección de Mesa -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Label Text="🪑 Seleccionar Mesa" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"
                               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding MesasDisponibles}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" 
                                                 Span="6" 
                                                 VerticalItemSpacing="8" 
                                                 HorizontalItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{Binding ColorEstado}"
                                           Padding="0"
                                           CornerRadius="10"
                                           HasShadow="True"
                                           HeightRequest="60"
                                           WidthRequest="60"
                                           BorderColor="{Binding BorderColor}"
                                           Opacity="{Binding OpacidadMesa}"
                                           IsEnabled="{Binding EstaHabilitadaParaSeleccion}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.SeleccionarMesaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding}"/>
                                        </Frame.GestureRecognizers>
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="12">
                                            <Label Text="{Binding Numero}" 
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding CapacidadTexto}" 
                                                   TextColor="White"
                                                   FontSize="10"
                                                   HorizontalOptions="Center"
                                                   Opacity="0.8"/>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Frame BackgroundColor="#E3F2FD" 
                               CornerRadius="8" 
                               Padding="15" 
                               Margin="0,15,0,0"
                               HasShadow="False"
                               IsVisible="{Binding MesaSeleccionada, Converter={StaticResource IsNotNullConverter}}">
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="✓ Mesa seleccionada: " TextColor="#1976D2" FontSize="14"/>
                                        <Span Text="{Binding MesaSeleccionada.Numero}" TextColor="#1976D2" FontSize="14" FontAttributes="Bold"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Frame>

                        <StackLayout Orientation="Horizontal" Spacing="15" HorizontalOptions="Center" Margin="0,15,0,0">
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Green" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Disponible" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Orange" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Ocupada" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <BoxView Color="Red" WidthRequest="15" HeightRequest="15" CornerRadius="3"/>
                                <Label Text="Por pagar" FontSize="11" TextColor="#666" VerticalOptions="Center"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Categorías -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Label Text="🍽️ Categorías del Menú" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"
                               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding Categorias}"
                                        SelectedItem="{Binding CategoriaSeleccionada}"
                                        SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding NombreConIcono}"
                                            BackgroundColor="{Binding ColorFondo}"
                                            TextColor="White"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            Padding="20,12"
                                            MinimumWidthRequest="100"
                                            Command="{Binding BindingContext.SeleccionarCategoriaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- PRODUCTOS DISPONIBLES - CÓDIGO CORREGIDO -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True">
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="📋 Productos Disponibles" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#333"/>
                            <Label Grid.Column="1"
                                   Text="{Binding PlatillosFiltrados.Count, StringFormat='{0} productos'}"
                                   FontSize="12"
                                   TextColor="#666"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <SearchBar Placeholder="Buscar productos..."
                                   Text="{Binding BusquedaTexto}"
                                   BackgroundColor="#F8F9FA"
                                   Margin="0,15,0,10"/>

                        <CollectionView ItemsSource="{Binding PlatillosFiltrados}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- LAYOUT CORREGIDO: Vertical en lugar de horizontal -->
                                    <Frame BackgroundColor="#FAFAFA" 
                                           CornerRadius="12" 
                                           Padding="15" 
                                           Margin="0,8"
                                           HasShadow="False">

                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

                                            <!-- FILA 1: Icono + Nombre -->
                                            <Grid Grid.Row="0" ColumnDefinitions="60,*" ColumnSpacing="12">
                                                <Frame Grid.Column="0" 
                                                       CornerRadius="10" 
                                                       Padding="0"
                                                       HeightRequest="60"
                                                       WidthRequest="60"
                                                       BackgroundColor="#E9ECEF"
                                                       HasShadow="False">
                                                    <Label Text="🍽️"
                                                           FontSize="28"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Frame>

                                                <StackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Nombre}" 
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           TextColor="#333"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="2"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- FILA 2: Descripción -->
                                            <Label Grid.Row="1" 
                                                   Text="{Binding Descripcion}" 
                                                   FontSize="12"
                                                   TextColor="#666"
                                                   LineBreakMode="WordWrap"
                                                   MaxLines="3"/>

                                            <!-- FILA 3: Precio -->
                                            <Label Grid.Row="2" 
                                                   Text="{Binding PrecioFormateado}" 
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   TextColor="#FF6B35"/>

                                            <!-- FILA 4: Controles de cantidad -->
                                            <StackLayout Grid.Row="3" 
                                                         Orientation="Horizontal"
                                                         HorizontalOptions="End"
                                                         Spacing="10">

                                                <!-- Botones cuando tiene cantidad -->
                                                <StackLayout Orientation="Horizontal" 
                                                             Spacing="10"
                                                             IsVisible="{Binding CantidadTemporal, Converter={StaticResource IntToBoolConverter}}">
                                                    <Button Text="−"
                                                            BackgroundColor="#DC3545"
                                                            TextColor="White"
                                                            FontSize="20"
                                                            FontAttributes="Bold"
                                                            CornerRadius="20"
                                                            WidthRequest="40"
                                                            HeightRequest="40"
                                                            Padding="0"
                                                            Command="{Binding BindingContext.DisminuirCantidadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Frame BackgroundColor="#F8F9FA"
                                                           Padding="15,10"
                                                           CornerRadius="20"
                                                           HasShadow="False"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding CantidadTemporal}"
                                                               FontAttributes="Bold"
                                                               FontSize="16"
                                                               TextColor="#333"/>
                                                    </Frame>

                                                    <Button Text="+"
                                                            BackgroundColor="#28A745"
                                                            TextColor="White"
                                                            FontSize="20"
                                                            FontAttributes="Bold"
                                                            CornerRadius="20"
                                                            WidthRequest="40"
                                                            HeightRequest="40"
                                                            Padding="0"
                                                            Command="{Binding BindingContext.AumentarCantidadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackLayout>

                                                <!-- Botón agregar cuando cantidad = 0 -->
                                                <Button Text="+ Agregar"
                                                        BackgroundColor="#28A745"
                                                        TextColor="White"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        CornerRadius="20"
                                                        Padding="20,10"
                                                        IsVisible="{Binding CantidadTemporal, Converter={StaticResource IntToBoolInverseConverter}}"
                                                        Command="{Binding BindingContext.AgregarProductoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Resumen del Pedido -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="20" 
                       HasShadow="True"
                       IsVisible="{Binding TienePedidoActual}">
                    <StackLayout>
                        <Label Text="🛒 Resumen del Pedido" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"
                               Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding ItemsPedidoActual}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,8">
                                        <StackLayout Grid.Column="0">
                                            <Label Text="{Binding Platillo.Nombre}" 
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="#333"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding Platillo.PrecioFormateado}" 
                                                   FontSize="12"
                                                   TextColor="#666"/>
                                        </StackLayout>

                                        <Label Grid.Column="1" 
                                               Text="{Binding Cantidad, StringFormat='x{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#FF6B35"
                                               VerticalOptions="Center"
                                               Margin="0,0,15,0"/>

                                        <Button Grid.Column="2"
                                                Text="🗑️"
                                                BackgroundColor="Transparent"
                                                TextColor="#DC3545"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                Command="{Binding BindingContext.EliminarItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,15"/>

                        <Entry Placeholder="Notas especiales para el pedido..."
                               Text="{Binding NotasPedido}"
                               BackgroundColor="#F8F9FA"
                               HeightRequest="60"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,15,0,0">
                            <Label Grid.Column="0"
                                   Text="TOTAL:" 
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding TotalPedido, StringFormat='${0:N0}'}"
                                   FontAttributes="Bold"
                                   FontSize="24"
                                   TextColor="#FF6B35"/>
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Botón Confirmar -->
        <Frame Grid.Row="2" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="20,15"
               HasShadow="True"
               IsVisible="{Binding TienePedidoActual}">
            <StackLayout Spacing="10">
                <!-- Mensaje de validación si no puede confirmar -->
                <Label Text="⚠️ Selecciona una mesa y agrega productos para continuar"
                   FontSize="12"
                   TextColor="#DC3545"
                   HorizontalOptions="Center"
                   IsVisible="{Binding PuedeConfirmarPedido, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Text="Confirmar Pedido"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="55"
                    IsEnabled="{Binding PuedeConfirmarPedido}"
                    Command="{Binding ConfirmarPedidoCommand}"/>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>