<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RestaurantApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RestaurantApp.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- Login (pantalla inicial) -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate local:LoginView}"
        Shell.NavBarIsVisible="False"/>

    <!-- MeseroMainView (pantalla principal) -->
    <ShellContent
        Route="mesero"
        ContentTemplate="{DataTemplate local:MeseroMainView}"
        Shell.NavBarIsVisible="True"/>

    <!-- Rutas adicionales (ocultas) -->
    <ShellContent
        Route="inicio"
        ContentTemplate="{DataTemplate local:MeseroMainView}"
        FlyoutItemIsVisible="False"/>

    <ShellContent
        Route="nuevopedido"
        ContentTemplate="{DataTemplate local:NuevoPedidoView}"
        FlyoutItemIsVisible="False"/>

    <ShellContent
        Route="pedidosactivos"
        ContentTemplate="{DataTemplate local:PedidosActivosView}"
        FlyoutItemIsVisible="False"/>

    <ShellContent
        Route="configuracion"
        ContentTemplate="{DataTemplate local:ConfiguracionView}"
        FlyoutItemIsVisible="False"/>

</Shell>