<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RestaurantApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RestaurantApp.Views"
    Title="RestaurantApp"
    Shell.FlyoutBehavior="Disabled">

    <!-- Rutas principales -->
    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate local:MeseroMainView}"
        Route="inicio" />

    <ShellContent
        Title="Nuevo Pedido"
        ContentTemplate="{DataTemplate local:NuevoPedidoView}"
        Route="nuevopedido" />

    <ShellContent
        Title="Pedidos Activos"
        ContentTemplate="{DataTemplate local:PedidosActivosView}"
        Route="pedidosactivos" />

    <ShellContent
        Title="Configuración"
        ContentTemplate="{DataTemplate local:ConfiguracionView}"
        Route="configuracion" />

</Shell>